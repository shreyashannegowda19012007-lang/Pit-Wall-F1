# ==================================================
# Pitwall F1 Platform Environment Configuration Template
# ==================================================

# Server Configuration
PORT=8501
HOST=localhost
ENVIRONMENT=production
DEBUG=false

# Caching
CACHE_ENABLED=true
FASTF1_CACHE_DIR=./cache/fastf1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pitwall_f1
POSTGRES_USER=placeholder_db_user
POSTGRES_PASSWORD=placeholder_db_password

# Telemetry APIs
OPENF1_CLIENT_ID=placeholder_openf1_client_id
OPENF1_CLIENT_SECRET=placeholder_openf1_client_secret

# AI / ML
# API keys for any external LLMs or ML APIs
AI_ENGINEER_API_KEY=placeholder_ai_api_key
