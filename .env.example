# ==================================================
# Pitwall F1 Platform Environment Configuration Template
# ==================================================

# Server Configuration
PORT=8000
HOST=localhost
ENVIRONMENT=production
DEBUG=false

# Caching
CACHE_ENABLED=true
FASTF1_CACHE_DIR=./cache/fastf1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pitwall_f1
POSTGRES_USER=placeholder_db_user
POSTGRES_PASSWORD=placeholder_db_password

# Live Telemetry Provider Configuration
# PITWALL_LIVE_PROVIDER options: F1_SIGNALR_CORE (default, 100% free, no subscription required)
PITWALL_LIVE_PROVIDER=F1_SIGNALR_CORE

# Optional Historical Providers (Only used for historical queries; NOT required for live feeds)
OPENF1_CLIENT_ID=optional_openf1_client_id
OPENF1_CLIENT_SECRET=optional_openf1_client_secret
OPENF1_API_KEY=optional_openf1_api_key

# AI / ML
# API keys for any external LLMs or ML APIs
AI_ENGINEER_API_KEY=placeholder_ai_api_key
